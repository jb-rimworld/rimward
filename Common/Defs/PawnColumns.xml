<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnColumnDef>
        <defName>RimWard_LabelCustom</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_LabelCustom</workerClass>
        <sortable>false</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_PatientRating</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_PatientRating</workerClass>
        <label>rating</label>
        <headerTip>How much better the patient feels than on arrival. Above 60% earns extra goodwill on discharge.</headerTip>
        <width>45</width>
        <sortable>true</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_PatientTimeSpent</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_PatientTimeSpent</workerClass>
        <label>time spent</label>
        <headerTip>How long the patient has been in your hospital.</headerTip>
        <width>45</width>
        <sortable>true</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_PatientDiagnosis</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_Diagnosis</workerClass>
        <label>diagnosis</label>
        <headerTip>What is wrong with this patient.</headerTip>
        <width>175</width>
        <sortable>false</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_PatientCure</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_Cure</workerClass>
        <label>treatment</label>
        <headerTip>How we will help the patient.</headerTip>
        <width>175</width>
        <sortable>false</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_PatientBill</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_Bill</workerClass>
        <label>bill</label>
        <headerTip>What the patient would pay if discharged cured right now: the same invoice that pays out. Hover a row for the itemised bill.</headerTip>
        <width>45</width>
        <sortable>true</sortable>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_Dismiss</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_ButtonDismiss</workerClass>
        <width>100</width>
    </PawnColumnDef>

    <PawnColumnDef>
        <defName>RimWard_Disallow</defName>
        <workerClass>RimWard.MainTab.PawnColumnWorker_ButtonDisallow</workerClass>
        <width>300</width>
    </PawnColumnDef>
</Defs>
